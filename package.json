{
  "name": "unbreak-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A small inventory API on Express 4, kept on the record so anyone can watch Unbreak fix its failing Dependabot PRs. https://unbrkn.co",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.25.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unbrkntruth/unbreak-demo"
  }
}
